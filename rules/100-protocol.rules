alert tcp any 21 -> any any (msg:"FTP first directory change monitoring"; flow:established,to_client; content:"230 ",offset 0,depth 4; flowbits:set,ftp.await_first_cwd; flowbits:noalert; sid:1001200; rev:1;)
alert tcp any any -> any 21 (msg:"FTP first parent directory access"; flow:established,to_server; flowbits:isset,ftp.await_first_cwd; content:"CWD ..",offset 0,depth 6,nocase; pcre:"/^CWD \.\.(?:\/[^\r\n]*)?\r\n$/i"; flowbits:unset,ftp.await_first_cwd; flowbits:set,ftp.cwd_risky_pending; sid:1001201; rev:1;)
alert tcp any any -> any 21 (msg:"FTP first normal directory change"; flow:established,to_server; flowbits:isset,ftp.await_first_cwd; content:"CWD ",offset 0,depth 4,nocase; content:!"CWD ..",offset 0,depth 6,nocase; content:!"CWD /",offset 0,depth 5,nocase; flowbits:unset,ftp.await_first_cwd; flowbits:noalert; sid:1001202; rev:1;)
