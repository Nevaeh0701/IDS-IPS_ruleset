# ============================================================================
# HTTP (27 rules)
# ============================================================================

alert tcp $HOME_NET $HTTP_PORTS -> any any (msg:"HTTP BASELINE 200 OK"; flow:to_client,established; http_stat_code; content:"200"; sid:1002000; rev:1;)
alert tcp $HOME_NET $HTTP_PORTS -> any any (msg:"HTTP BASELINE 301 Moved Permanently"; flow:to_client,established; http_stat_code; content:"301"; sid:1002001; rev:1;)
