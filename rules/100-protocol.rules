# ============================================================================
# pydio (6 rules)
# ============================================================================

alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS ( msg:"EXPLOIT-KIT Pydio Cells Executable File Upload Attempt"; flow:to_server,established; http_method; content:"PUT"; http_uri; content:"/a/dav/",fast_pattern; pcre:"/\.(php[3-7]?|phtml|jsp|sh|cgi|pl)(\?|$)/i"; sid:1009101; rev:1; )
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS ( msg:"EXPLOIT-KIT Pydio Cells Webshell Malicious Code Payload Injected"; flow:to_server,established; http_uri; content:"/a/dav/",fast_pattern; http_client_body; pcre:"/(system|exec|passthru|eval|shell_exec|base64_decode)\s*\(/i"; sid:1009102; rev:1; )
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS ( msg:"ATTACK-RESPONSES Pydio Cells Login Brute-Force Attack Attempt (Request Rate)"; flow:to_server,established; http_method; content:"POST"; http_uri; content:"/a/auth/login",fast_pattern; detection_filter:track by_src, count 10, seconds 10; sid:1009103; rev:1; )
alert http $HOME_NET $HTTP_PORTS -> $EXTERNAL_NET any ( msg:"ATTACK-RESPONSES Pydio Cells Excessive Login Failures (401 Unauthorized)"; flow:to_client,established; http_stat_code; content:"401"; detection_filter:track by_dst, count 5, seconds 10; sid:1009104; rev:1; )
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS ( msg:"EXPLOIT-KIT Pydio Cells Directory Traversal Attempt"; flow:to_server,established; http_uri; content:"../",fast_pattern; http_uri; pcre:"/(?:\.\.[\/\\\\]|%2e%2e[%2f%5c]){2,}/i"; sid:1009105; rev:1; )
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS ( msg:"EXPLOIT-KIT Pydio Cells Path Traversal Sensitive File Access Attempt"; flow:to_server,established; http_uri; content:"..",fast_pattern; http_uri; pcre:"/(?:\.\.[\/\\\\]|%2e%2e[%2f%5c]).*(?:etc\/(?:passwd|shadow|hosts)|boot\.ini|win\.ini|WEB-INF)/i"; sid:1009106; rev:1; )

