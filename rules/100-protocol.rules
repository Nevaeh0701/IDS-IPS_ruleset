# 100 series - Protocol / Infrastructure
# Source: original project ruleset spreadsheet
# Rules are preserved as written in the source spreadsheet.

# ============================================================================
# FTP (92 rules)
# ============================================================================

alert tcp any any -> any 21 (msg:"FTP connection request"; flow:stateless; flags:S; sid:1001001; rev:1;)
alert tcp any 21 -> any any (msg:"FTP connection accepted"; flow:stateless; flags:SA; sid:1001002; rev:1;)
alert tcp any 21 -> any any (msg:"FTP service ready"; flow:established,to_client; content:"220 ",offset 0,depth 4; sid:1001004; rev:1;)
alert tcp any any -> any 21 (msg:"FTP username submitted"; flow:established,to_server; content:"USER ",offset 0,depth 5,nocase; sid:1001005; rev:1;)
alert tcp any 21 -> any any (msg:"FTP password requested"; flow:established,to_client; content:"331 ",offset 0,depth 4; sid:1001006; rev:1;)
alert tcp any any -> any 21 (msg:"FTP password submitted"; flow:established,to_server; content:"PASS ",offset 0,depth 5,nocase; sid:1001007; rev:1;)
alert tcp any 21 -> any any (msg:"FTP login successful"; flow:established,to_client; content:"230 ",offset 0,depth 4; sid:1001008; rev:1;)
alert tcp any any -> any 21 (msg:"FTP server type requested"; flow:established,to_server; content:"SYST|0D 0A|",offset 0,depth 6,nocase; sid:1001009; rev:1;)
alert tcp any 21 -> any any (msg:"FTP UNIX server confirmed"; flow:established,to_client; content:"215 UNIX Type: L8",offset 0,depth 17,nocase; sid:1001010; rev:1;)
alert tcp any 21 -> any any (msg:"FTP login failed"; flow:established,to_client; content:"530 ",offset 0,depth 4; sid:1001011; rev:1;)
alert tcp any any -> any 21 (msg:"FTP session close requested"; flow:established,to_server; content:"QUIT|0D 0A|",offset 0,depth 6,nocase; flowbits:set,ftp_quit; sid:1001012; rev:1;)
alert tcp any 21 -> any any (msg:"FTP session closed normally"; flow:established,to_client; flowbits:isset,ftp_quit; content:"221 ",offset 0,depth 4; flowbits:set,ftp_221; sid:1001013; rev:1;)
alert tcp any 21 -> any any (msg:"FTP server closed connection"; flags:FA; dsize:0; sid:1001014; rev:2;)
alert tcp any any -> any 21 (msg:"FTP client closed connection"; flags:FA; dsize:0; sid:1001015; rev:2;)
alert tcp any 21 -> any any (msg:"FTP session timed out"; flow:established,to_client; content:"421 ",offset 0,depth 4; flowbits:set,ftp_timeout; sid:1001016; rev:1;)
