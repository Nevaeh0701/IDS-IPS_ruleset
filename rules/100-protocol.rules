# ============================================================================
# SNMP-cacti (17 rules)
# ============================================================================

alert udp $EXTERNAL_NET any -> $HOME_NET 161 ( msg:"PROTOCOL-SNMP v2c default community public unauthorized access attempt"; flow:to_server; content:"|02 01 01 04 06|public", depth 24; classtype:policy-violation; sid:1003001; rev:2; )
alert udp $EXTERNAL_NET any -> $HOME_NET 161 ( msg:"OS-OTHER SNMP MIB-II sysDescr OID system fingerprinting query"; flow:to_server; content:"|02 01 01 04 06|public", depth 24; content:"|06 08 2b 06 01 02 01 01 01 00|"; classtype:attempted-recon; sid:1003002; rev:2; )
alert udp $EXTERNAL_NET any -> $HOME_NET 161 ( msg:"PROTOCOL-SNMP MIB-II ifTable 32bit interface counter enumeration"; flow:to_server; content:"|02 01 01|", depth 12; content:"|06 0a 2b 06 01 02 01 02 02 01|"; classtype:attempted-recon; sid:1003003; rev:2; )
alert udp $EXTERNAL_NET any -> $HOME_NET 161 ( msg:"PROTOCOL-SNMP Router v2c unauthorized access attempt"; flow:to_server; content:"|02 01 01 04 06|public", depth 24; content:"|2b 06 01 04 01 09|"; classtype:attempted-recon; sid:1003004; rev:2; )
alert udp $EXTERNAL_NET any -> $HOME_NET 161 ( msg:"OS-CISCO SNMP Cisco Enterprise MIB reconnaissance query"; flow:to_server; content:"|02 01 01|", depth 12; content:"|06 0a 2b 06 01 04 01 09 02 01 3a 00|"; classtype:attempted-recon; sid:1003005; rev:2; )
alert udp $EXTERNAL_NET any -> $HOME_NET 161 ( msg:"PROTOCOL-SNMP MIB-II ifXTable 64bit high-capacity interface discovery"; flow:to_server; content:"|02 01 01|", depth 12; content:"|06 0b 2b 06 01 02 01 1f 01 01 01|"; classtype:attempted-recon; sid:1003006; rev:2; )
alert udp $EXTERNAL_NET any -> $HOME_NET 161 ( msg:"PROTOCOL-SNMP Linux Host v2c unauthorized access attempt"; flow:to_server; content:"|02 01 01 04 06|public", depth 24; content:"|2b 06 01 04 01 8f 65|"; classtype:attempted-recon; sid:1003007; rev:2; )
alert udp $EXTERNAL_NET any -> $HOME_NET 161 ( msg:"OS-LINUX SNMP Net-SNMP Enterprise MIB resource discovery"; flow:to_server; content:"|02 01 01|", depth 12; content:"|2b 06 01 04 01 8f 65|"; classtype:attempted-recon; sid:1003008; rev:2; )
