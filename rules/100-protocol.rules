alert tcp any any -> any 21 (msg:"FTP risky path listing attempt"; flow:established,to_server; flowbits:isset,ftp.cwd_risky_path; content:"LIST",offset 0,depth 4,nocase; flowbits:unset,ftp.cwd_risky_path; flowbits:set,ftp.risky_list_pending; sid:1001205; rev:1;)
alert tcp any 21 -> any any (msg:"FTP risky path data exposed"; flow:established,to_client; flowbits:isset,ftp.risky_list_pending; content:"226 ",offset 0,depth 4; flowbits:unset,ftp.risky_list_pending; sid:1001206; rev:1;)
