# ============================================================================
# DNS (8 rules)
# ============================================================================

alert udp $HOME_NET any -> any 53 ( msg:"PROTOCOL-DNS query - A record lookup"; flow:to_server; pkt_data; content:"|00 01 00 01|"; classtype:protocol-command-decode; sid:1004001; rev:2; )
alert udp $HOME_NET any -> any 53 ( msg:"PROTOCOL-DNS query - AAAA record lookup"; flow:to_server; pkt_data; content:"|00 1c 00 01|"; classtype:protocol-command-decode; sid:1004002; rev:2; )
alert udp any 53 -> $HOME_NET any ( msg:"PROTOCOL-DNS response - SOA record disclosure"; flow:to_client; pkt_data; content:"|00 06 00 01|"; classtype:policy-violation; sid:1004003; rev:2; )
alert udp $HOME_NET any -> $EXTERNAL_NET 53 ( msg:"SEC-DNS Plaintext Query for Internal/Private Domain TLD"; flow:to_server; pkt_data; pcre:"/(?:\x08internal|\x05local|\x04test|\x04corp|\x03lan|\x04priv|\x08intranet)\x00/i"; classtype:protocol-command-decode; sid:1004004; rev:2; )
alert udp $EXTERNAL_NET 53 -> $HOME_NET any ( msg:"SEC-DNS Response Internal Hostname Exposure (WIN-/DESKTOP-/SERVER-/DC-)"; flow:to_client; pkt_data; pcre:"/(win|desktop|server|dc)-/i"; classtype:information-leak; sid:1004005; rev:2; )
alert tcp $HOME_NET any -> $EXTERNAL_NET 53 ( msg:"SEC-DNS Zone Transfer Request (AXFR/IXFR) Reconnaissance Attempt"; flow:to_server,established; pkt_data; pcre:"/\x00(?:\xfb|\xfc)\x00\x01/"; classtype:attempted-recon; sid:1004006; rev:2; )
alert udp $HOME_NET any -> $EXTERNAL_NET 53 ( msg:"SEC-DNS Potential DNS Tunneling - Abnormally Long Subdomain Query"; flow:to_server; pkt_data; pcre:"/^.{12}[\x32-\x3f][^\x00]{50,63}/s"; classtype:bad-unknown; sid:1004007; rev:2; )
alert udp $HOME_NET any -> $EXTERNAL_NET 53 ( msg:"SEC-DNS Unauthorized Dynamic DNS Update Request"; flow:to_server; pkt_data; pcre:"/^..[\x28-\x2f]/s"; classtype:protocol-command-decode; sid:1004008; rev:2; )

# ============================================================================
# SSH (8 rules)
# ============================================================================

alert tcp $EXTERNAL_NET any -> $HOME_NET 22 ( msg:"SEC-POLICY SSH libssh client connection attempt"; flow:to_server,established; content:"SSH-2.0-", depth 8; content:"libssh", nocase; classtype:unusual-client-behavior; sid:1005001; rev:2; )
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 ( msg:"PROTOCOL-OTHER SSH KEXInit message detected"; flow:to_server,established; pkt_data; content:"|14|", offset 5, depth 1; classtype:protocol-command-decode; sid:1005002; rev:2; )
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 ( msg:"ATTACK-RESPONSES SSH Brute Force Inbound Attempt"; flow:to_server,established; content:"SSH-2.0-", depth 8; detection_filter:track by_src, count 18, seconds 30; classtype:attempted-admin; sid:1005003; rev:2; )
alert tcp any any -> any any ( msg:"SSH-DETECT OpenSSH/SSH-2.0 server banner"; flow:established,to_client; content:"SSH-2.0-", depth 8, nocase; pcre:"/^SSH-2\.0-[\w\.\-]+/i"; classtype:protocol-command-decode; sid:1005004; rev:2; )
alert tcp any any -> any any ( msg:"SSH-DETECT client protocol banner SSH-2.0-OpenSSH"; flow:established,to_server; content:"SSH-2.0-", depth 8, nocase; content:"OpenSSH_", distance 0, within 40, nocase; classtype:protocol-command-decode; sid:1005005; rev:2; )
alert tcp any any -> any any ( msg:"SSH-DETECT KEXINIT offers curve25519-sha256 and chacha20-poly1305"; flow:established; content:"curve25519-sha256", nocase; content:"chacha20-poly1305@openssh.com", nocase; classtype:policy-violation; sid:1005006; rev:2; )
alert tcp any !22 -> any any ( msg:"SSH-SUSPECT banner on non-standard port"; flow:established,to_client; content:"SSH-2.0-", depth 8, nocase; classtype:trojan-activity; sid:1005007; rev:2; )
alert tcp any any -> $HOME_NET 22 ( msg:"SSH-BRUTE possible many client banners to sshd"; flow:established,to_server; content:"SSH-2.0-", depth 8, nocase; detection_filter:track by_src, count 38, seconds 60; classtype:attempted-admin; sid:1005008; rev:2; )

