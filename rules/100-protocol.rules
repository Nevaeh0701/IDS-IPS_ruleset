alert tcp $HOME_NET $HTTP_PORTS -> any any (msg:"HTTP BASELINE 403 Forbidden"; flow:to_client,established; http_stat_code; content:"403"; sid:1002006; rev:1;)
alert tcp $HOME_NET $HTTP_PORTS -> any any (msg:"HTTP BASELINE 404 Not Found"; flow:to_client,established; http_stat_code; content:"404"; sid:1002007; rev:1;)
alert tcp $HOME_NET $HTTP_PORTS -> any any (msg:"HTTP BASELINE 405 Method Not Allowed"; flow:to_client,established; http_stat_code; content:"405"; sid:1002008; rev:1;)
alert tcp $HOME_NET $HTTP_PORTS -> any any (msg:"HTTP BASELINE 408 Request Timeout"; flow:to_client,established; http_stat_code; content:"408"; sid:1002009; rev:1;)
alert tcp $HOME_NET $HTTP_PORTS -> any any (msg:"HTTP BASELINE 429 Too Many Requests"; flow:to_client,established; http_stat_code; content:"429"; sid:1002010; rev:1;)
alert tcp $HOME_NET $HTTP_PORTS -> any any (msg:"HTTP BASELINE 500 Internal Server Error"; flow:to_client,established; http_stat_code; content:"500"; sid:1002011; rev:1;)
alert tcp $HOME_NET $HTTP_PORTS -> any any (msg:"HTTP BASELINE 502 Bad Gateway"; flow:to_client,established; http_stat_code; content:"502"; sid:1002012; rev:1;)
alert tcp $HOME_NET $HTTP_PORTS -> any any (msg:"HTTP BASELINE 503 Service Unavailable"; flow:to_client,established; http_stat_code; content:"503"; sid:1002013; rev:1;)
alert tcp $HOME_NET $HTTP_PORTS -> any any (msg:"HTTP BASELINE 504 Gateway Timeout"; flow:to_client,established; http_stat_code; content:"504"; sid:1002014; rev:1;)
alert tcp any any -> $HOME_NET $HTTP_PORTS (msg:"HTTP BASELINE GET Request"; flow:to_server,established; http_method; content:"GET"; sid:1002015; rev:1;)
alert tcp any any -> $HOME_NET $HTTP_PORTS (msg:"HTTP BASELINE HEAD Request"; flow:to_server,established; http_method; content:"HEAD"; sid:1002016; rev:1;)
alert tcp any any -> $HOME_NET $HTTP_PORTS (msg:"HTTP BASELINE POST Request"; flow:to_server,established; http_method; content:"POST"; sid:1002017; rev:1;)
alert tcp any any -> $HOME_NET $HTTP_PORTS (msg:"HTTP BASELINE PUT Request"; flow:to_server,established; http_method; content:"PUT"; sid:1002018; rev:1;)
alert tcp any any -> $HOME_NET $HTTP_PORTS (msg:"HTTP BASELINE PATCH Request"; flow:to_server,established; http_method; content:"PATCH"; sid:1002019; rev:1;)
alert tcp any any -> $HOME_NET $HTTP_PORTS (msg:"HTTP BASELINE DELETE Request"; flow:to_server,established; http_method; content:"DELETE"; sid:1002020; rev:1;)
